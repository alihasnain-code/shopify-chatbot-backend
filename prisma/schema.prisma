generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

model aipersonasettings {
  id                 Int      @id @default(autoincrement())
  sessionId          String   @unique(map: "AiPersonaSettings_sessionId_key")
  customInstructions String?  @db.Text
  tone               String   @default("standard")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  session            session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "AiPersonaSettings_sessionId_fkey")
}

model conversation {
  id        String    @id
  shop      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  cartId    String?
  message   message[]

  @@index([shop], map: "Conversation_shop_idx")
}

model form {
  id            Int             @id @default(autoincrement())
  sessionId     String
  name          String
  status        String          @default("active")
  fields        String          @db.LongText
  version       Int             @default(1)
  position      Int             @default(0)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  session       session         @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "Form_sessionId_fkey")
  formResponses form_response[]

  @@unique([sessionId, name], map: "Form_sessionId_name_key")
  @@index([sessionId], map: "Form_sessionId_idx")
}

model message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.LongText
  createdAt      DateTime     @default(now())
  conversation   conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade, map: "Message_conversationId_fkey")

  @@index([conversationId], map: "Message_conversationId_idx")
}

model session {
  id                  String             @id
  shop                String
  state               String
  isOnline            Boolean            @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean            @default(false)
  locale              String?
  collaborator        Boolean?           @default(false)
  emailVerified       Boolean?           @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
  tokensUsed          Int                @default(0) @map("tokens_used")
  usageResetAt        DateTime?          @map("usage_reset_at")
  aipersonasettings   aipersonasettings?
  form                form[]
  starterquestion     starterquestion[]
  usagesettings       usagesettings?
  formResponses       form_response[]
  visitorUsages       visitor_usage[]
  orders              order[]
  plan                plan?              @relation(fields: [planId], references: [id])
  planId              Int?
  charges             charges[]
}

model starterquestion {
  id        Int      @id @default(autoincrement())
  sessionId String
  question  String   @db.VarChar(150)
  position  Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session   session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "StarterQuestion_sessionId_fkey")

  @@index([sessionId], map: "StarterQuestion_sessionId_idx")
}

model usagesettings {
  id                         Int      @id @default(autoincrement())
  sessionId                  String   @unique(map: "UsageSettings_sessionId_key")
  maxMessagesPerConversation Int      @default(15)
  maxMessagesPerVisitor      Int      @default(100)
  resetPeriod                String   @default("hour")
  verificationMethod         String   @default("email")
  limitReachedMessage        String?  @db.Text
  createdAt                  DateTime @default(now())
  updatedAt                  DateTime @updatedAt
  session                    session  @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "UsageSettings_sessionId_fkey")
}

model form_response {
  id        Int      @id @default(autoincrement())
  formId    Int
  sessionId String
  data      String   @db.Text
  createdAt DateTime @default(now())

  form    form    @relation(fields: [formId], references: [id], onDelete: Cascade, map: "FormResponse_formId_fkey")
  session session @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "FormResponse_sessionId_fkey")
}

model visitor_usage {
  id           Int      @id @default(autoincrement())
  sessionId    String
  ip           String   @db.VarChar(64)
  windowStart  DateTime @default(now())
  messageCount Int      @default(0)
  updatedAt    DateTime @updatedAt

  session session @relation(fields: [sessionId], references: [id], onDelete: Cascade, map: "VisitorUsage_sessionId_fkey")

  @@unique([sessionId, ip], map: "VisitorUsage_sessionId_ip_key")
}

model order {
  id                Int       @id @default(autoincrement())
  sessionId         String
  shopifyOrderId    String    @unique
  orderNumber       Int
  orderName         String
  email             String?
  emailSource       String? // 'root' | 'customer' | null
  phone             String?
  phoneSource       String? // 'root' | 'customer' | 'shipping_address' | 'billing_address' | null
  financialStatus   String?
  fulfillmentStatus String?
  currency          String?
  totalPrice        String?
  lineItems         String    @db.Text // JSON string: [{ title, variantTitle, quantity }]
  shippingCity      String?
  shippingProvince  String?
  shippingCountry   String?
  cancelledAt       DateTime?
  cancelReason      String?
  shopifyCreatedAt  DateTime
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  session      session             @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  fulfillments order_fulfillment[]

  @@index([sessionId, orderNumber])
}

model order_fulfillment {
  id                   Int      @id @default(autoincrement())
  shopifyFulfillmentId String   @unique
  orderId              Int
  status               String?
  shipmentStatus       String?
  trackingCompany      String?
  trackingNumber       String?
  trackingUrl          String?
  shopifyCreatedAt     DateTime
  shopifyUpdatedAt     DateTime
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  order order @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model plan {
  id           Int      @id @default(autoincrement())
  type         String
  name         String   @unique
  price        Decimal  @db.Decimal(8, 2)
  interval     String?
  cappedAmount Decimal? @map("capped_amount") @db.Decimal(8, 2)
  terms        String?
  trialDays    Int?     @default(0) @map("trial_days")

  tokenLimit Int?  @map("token_limit")
  features   Json?

  test Boolean @default(false)

  onInstall Boolean @default(false) @map("on_install")

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")

  sessions session[]
  charges  charges[]

  @@map("plans")
}

model charges {
  id       Int    @id @default(autoincrement())
  chargeId BigInt @map("charge_id")

  test Boolean @default(false)

  status       String?
  name         String?
  terms        String?
  type         String
  price        Decimal  @db.Decimal(8, 2)
  interval     String?
  cappedAmount Decimal? @map("capped_amount") @db.Decimal(8, 2)
  trialDays    Int?     @map("trial_days")

  billingOn   DateTime? @map("billing_on")
  activatedOn DateTime? @map("activated_on")
  trialEndsOn DateTime? @map("trial_ends_on")
  cancelledOn DateTime? @map("cancelled_on")
  expiresOn   DateTime? @map("expires_on")

  planId Int?
  plan   plan? @relation(fields: [planId], references: [id])

  description     String?
  referenceCharge BigInt? @map("reference_charge")

  sessionId String  @map("session_id")
  session   session @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  createdAt DateTime? @default(now()) @map("created_at")
  updatedAt DateTime? @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  @@index([sessionId])
  @@index([planId])
  @@index([chargeId])
  @@map("charges")
}
